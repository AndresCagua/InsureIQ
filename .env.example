# ============================================================
# InsureIQ - variables de entorno de ejemplo
# Copia este archivo a .env y ajusta los valores locales:
#   cp .env.example .env
#
# NO agregues secretos reales a este archivo.
# Las credenciales se dejan vacias a proposito.
# ============================================================

# --- Proyecto ---
PROJECT_NAME=insureiq
ENVIRONMENT=local
LOG_LEVEL=INFO
TZ=America/Guayaquil

# --- Perfil de configuracion ---
# Valores esperados: smoke | full | models
CONFIG_PROFILE=smoke
SYNTHETIC_SEED=42

# --- Puertos publicados en el host (loopback por defecto) ---
# Elegidos para evitar conflictos con puertos ya ocupados en el host.
POSTGRES_HOST_PORT=55432
MINIO_API_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
AIRFLOW_HOST_PORT=58080
MLFLOW_HOST_PORT=55000
API_HOST_PORT=58000
STREAMLIT_HOST_PORT=58501
JUPYTER_HOST_PORT=58888

# --- PostgreSQL ---
POSTGRES_DB=insureiq
POSTGRES_USER=insureiq
POSTGRES_PASSWORD=
# Ejemplo de formato (no usar credenciales reales aqui):
# DATABASE_URL=postgresql://usuario:password@postgres:5432/insureiq
DATABASE_URL=

# --- MinIO / almacenamiento compatible con S3 ---
MINIO_ROOT_USER=insureiq
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=insureiq
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Airflow (perfil orchestration) ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=

# --- MLflow (perfil mlops) ---
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=
MLFLOW_ARTIFACT_ROOT=s3://insureiq/mlflow

# --- API y demo ---
API_BASE_URL=http://api:8000
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# --- Rutas de datos ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SYNTHETIC_DIR=data/synthetic

# --- Power BI (solo capability spikes o despliegue autorizado) ---
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

# --- Tableau (solo capability spikes o publicacion autorizada) ---
TABLEAU_SERVER_URL=
TABLEAU_SITE=
TABLEAU_TOKEN_NAME=
TABLEAU_TOKEN_SECRET=

# --- Azure (despliegue opcional) ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_KEY_VAULT_URL=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=
