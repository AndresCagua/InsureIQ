Total Accidentes =
CALCULATE(
    SUM(public_iowa_crashes_summary[crashes]),
    public_iowa_crashes_summary[dimension] = "severity"
)

Categorías = DISTINCTCOUNT(public_iowa_crashes_summary[category])

Accidentes por Condado =
CALCULATE(
    [Total Accidentes],
    public_iowa_crashes_summary[dimension] = "county"
)

Accidentes por Severidad = [Total Accidentes]

Accidentes por Mes =
CALCULATE(
    [Total Accidentes],
    public_iowa_crashes_summary[dimension] = "month_severity"
)
